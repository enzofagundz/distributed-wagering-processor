{
  "name": "distributed-wagering-processor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14 <2"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "bun test",
    "test:domain": "bun test tests/domain",
    "test:integration": "bun test tests/integration",
    "migration:up": "bun src/persistence/migrate.ts up",
    "migration:down": "bun src/persistence/migrate.ts down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@mgvdev/nest-boost": "0.4.0",
    "@types/bun": "1.3.14",
    "@types/passport-jwt": "4.0.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1156.0",
    "@mikro-orm/core": "6.6.8",
    "@mikro-orm/migrations": "6.6.8",
    "@mikro-orm/postgresql": "6.6.8",
    "@nestjs/common": "11.1.16",
    "@nestjs/core": "11.1.16",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "11.1.16",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "jwks-rsa": "4.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
